[Unit]
Description=Recover Pi Wi-Fi after five minutes disconnected
Wants=NetworkManager.service
After=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash /usr/local/lib/golf-leaderboard/pi_wifi_watchdog.sh
Restart=always
RestartSec=30
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
